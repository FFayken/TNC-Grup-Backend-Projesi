{
  "name": "taskflow-api",
  "version": "1.0.0",
  "description": "TaskFlow - Görev ve Proje Yönetim Sistemi REST API (Node.js + Express)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/data/seed.js",
    "test:postman": "newman run postman/TaskFlow.postman_collection.json -e postman/TaskFlow.local.postman_environment.json -r cli,htmlextra --reporter-htmlextra-export docs/test-raporu.html"
  },
  "keywords": [
    "nodejs",
    "express",
    "rest-api",
    "crud",
    "middleware"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "newman": "^6.2.3",
    "newman-reporter-htmlextra": "^1.23.1",
    "nodemon": "^3.1.14"
  }
}
