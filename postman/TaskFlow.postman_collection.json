{
  "info": {
    "name": "TaskFlow API",
    "description": "TaskFlow Görev ve Proje Yönetim Sistemi API - CRUD, filtreleme, doğrulama ve raporlama testleri.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CRUD (Zorunlu)",
      "item": [
        {
          "name": "1. Görev Ekle (POST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Durum kodu 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Görev oluşturuldu ve id döndü\", () => { pm.expect(json.success).to.be.true; pm.expect(json.data.id).to.be.a(\"number\"); });",
                  "pm.test(\"Varsayılan status 'todo'\", () => pm.expect(json.data.status).to.eql(\"todo\"));",
                  "pm.collectionVariables.set(\"taskId\", json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman ile CRUD testi yap\",\n  \"description\": \"Tüm uç noktaları Postman üzerinden doğrula.\",\n  \"priority\": \"high\",\n  \"assignee\": \"musa\",\n  \"project\": \"TaskFlow\",\n  \"dueDate\": \"2026-11-30\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2. Görevleri Listele (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Durum kodu 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Liste bir dizi\", () => pm.expect(json.data).to.be.an(\"array\"));",
                  "pm.test(\"Yeni eklenen görev listede\", () => pm.expect(json.data.map(t => t.id)).to.include(pm.collectionVariables.get(\"taskId\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
